        {
          "name": "signin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "let json;\r",
                  "pm.test('Parsable JSON body', function () {\r",
                  "  json = pm.response.json();\r",
                  "  pm.expect(json).to.be.an('object');\r",
                  "});\r",
                  "\r",
                  "pm.test('Success true', function () {\r",
                  "  pm.expect(json.success, 'success flag').to.be.true;\r",
                  "});\r",
                  "\r",
                  "pm.test('Has data object', function () {\r",
                  "  pm.expect(json).to.have.property('data');\r",
                  "  pm.expect(json.data).to.be.an('object');\r",
                  "});\r",
                  "\r",
                  "// Safely extract tokens from nested data or fallback\r",
                  "const tokens = {\r",
                  "  access_token: json?.data?.access_token || json?.access_token,\r",
                  "  refresh_token: json?.data?.refresh_token || json?.refresh_token,\r",
                  "  token_type: json?.data?.token_type || json?.token_type || 'Bearer'\r",
                  "};\r",
                  "\r",
                  "pm.test('Has tokens', function () {\r",
                  "  pm.expect(tokens).to.have.property('access_token');\r",
                  "  pm.expect(tokens.access_token, 'access_token is empty').to.be.a('string').and.not.empty;\r",
                  "  pm.expect(tokens).to.have.property('refresh_token');\r",
                  "  pm.expect(tokens.refresh_token, 'refresh_token is empty').to.be.a('string').and.not.empty;\r",
                  "  pm.expect(tokens.token_type).to.be.a('string');\r",
                  "});\r",
                  "\r",
                  "// Save tokens to environment for next requests\r",
                  "pm.environment.set('access_token', tokens.access_token);\r",
                  "pm.environment.set('refresh_token', tokens.refresh_token);\r",
                  "pm.environment.set('token_type', tokens.token_type);\r",
                  "\r",
                  "// Handy Authorization header\r",
                  "pm.environment.set('auth_header', `${tokens.token_type} ${tokens.access_token}`);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
